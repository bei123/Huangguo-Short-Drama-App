import { decryptImage } from '@/uni_modules/hg-edge'
import { HG_REFERER, resolveCoverUrl } from '../http/config.uts'

const memCache = new Map<string, string>()
const inflight = new Map<string, Promise<string> | null>()

/** 限制同时解密张数，避免列表「加载更多」时主线程卡顿 */
const COVER_MAX_PARALLEL = 3
let coverActive = 0
const coverWaiters: Array<() => void> = [] as Array<() => void>

function acquireCoverSlot(): Promise<void> {
	if (coverActive < COVER_MAX_PARALLEL) {
		coverActive++
		return Promise.resolve()
	}
	return new Promise<void>((resolve) => {
		coverWaiters.push(() => {
			coverActive++
			resolve()
		})
	})
}

function releaseCoverSlot() {
	coverActive--
	if (coverActive < 0) {
		coverActive = 0
	}
	if (coverWaiters.length > 0) {
		const next = coverWaiters.shift()
		if (next != null) {
			next!()
		}
	}
}

/** 同步读内存缓存，供 hg-cover 命中时立刻展示、避免闪占位 */
export function peekCachedCover(rawUrl: string): string {
	const url = resolveCoverUrl(rawUrl)
	if (url.length == 0) {
		return ''
	}
	const cached = memCache.get(url)
	if (cached != null && cached!.length > 0) {
		return cached!
	}
	return ''
}

/**
 * 下载 CDN 加密封面 → AES-CBC 智能解密 → 本地路径
 * 必须走 uni.request 异步下载：原生同步 HttpURLConnection 会触发 NetworkOnMainThreadException
 */
export function loadDecryptedCover(rawUrl: string): Promise<string> {
	const url = resolveCoverUrl(rawUrl)
	if (url.length == 0) {
		return Promise.reject(new Error('empty cover url'))
	}
	const cached = memCache.get(url)
	if (cached != null && cached!.length > 0) {
		return Promise.resolve(cached!)
	}
	const pending = inflight.get(url)
	if (pending != null) {
		return pending!
	}
	const job = acquireCoverSlot().then((): Promise<string> => {
		return fetchThenDecrypt(url).then((path: string): string => {
			releaseCoverSlot()
			memCache.set(url, path)
			inflight.set(url, null)
			return path
		}).catch((e: any): string => {
			releaseCoverSlot()
			inflight.set(url, null)
			throw e
		})
	})
	inflight.set(url, job)
	return job
}

function fetchThenDecrypt(url: string): Promise<string> {
	const disk = tryDiskCache(url)
	if (disk.length > 0) {
		return Promise.resolve(disk)
	}
	return new Promise<string>((resolve, reject) => {
		uni.request({
			url: url,
			method: 'GET',
			responseType: 'arraybuffer',
			header: {
				'Referer': HG_REFERER,
				'User-Agent': 'HuangguoAndroid/1.0',
				'Accept': '*/*'
			} as UTSJSONObject,
			timeout: 25000,
			success: (res) => {
				const statusCode = res.statusCode ?? 0
				if (statusCode < 200 || statusCode >= 300) {
					reject(new Error('cover http ' + statusCode))
					return
				}
				try {
					const buf = res.data as ArrayBuffer
					if (buf == null || buf.byteLength < 16) {
						reject(new Error('cover empty body'))
						return
					}
					const rawB64 = uni.arrayBufferToBase64(buf)
					const plainB64 = toPlainImageB64(rawB64)
					const ext = guessExtFromB64(plainB64)
					const outPath = buildCoverPath(url, ext)
					const fs = uni.getFileSystemManager()
					const dir = coverDir()
					try {
						fs.accessSync(dir)
					} catch (_) {
						try {
							fs.mkdirSync(dir, true)
						} catch (mkErr) {
							console.log('[cover] mkdir ' + mkErr)
						}
					}
					fs.writeFileSync(outPath, plainB64, 'base64')
					resolve(outPath)
				} catch (e) {
					reject(e as Error)
				}
			},
			fail: (err) => {
				reject(new Error(err.errMsg ?? 'cover download fail'))
			}
		})
	})
}

function coverDir(): string {
	return uni.env.USER_DATA_PATH + '/hg_covers'
}

function urlKey(url: string): string {
	let h = 0
	for (let i = 0; i < url.length; i++) {
		h = ((h << 5) - h) + url.charCodeAt(i)
		h = h | 0
	}
	const n = h < 0 ? -h : h
	return n.toString(16)
}

function buildCoverPath(url: string, ext: string): string {
	return coverDir() + '/hg_' + urlKey(url) + ext
}

function tryDiskCache(url: string): string {
	const key = urlKey(url)
	const exts = ['.jpg', '.png', '.webp', '.gif'] as string[]
	const fs = uni.getFileSystemManager()
	for (let i = 0; i < exts.length; i++) {
		const p = coverDir() + '/hg_' + key + exts[i]
		try {
			fs.accessSync(p)
			return p
		} catch (_) { }
	}
	return ''
}

function toPlainImageB64(rawB64: string): string {
	if (isPlainImageB64(rawB64)) {
		return rawB64
	}
	const plainB64 = decryptImage(rawB64)
	if (!isPlainImageB64(plainB64)) {
		throw new Error('decrypt not image')
	}
	return plainB64
}

function isPlainImageB64(b64: string): boolean {
	if (b64.indexOf('/9j') == 0) {
		return true
	}
	if (b64.indexOf('iVBOR') == 0) {
		return true
	}
	if (b64.indexOf('R0lGOD') == 0) {
		return true
	}
	if (b64.indexOf('UklGR') == 0) {
		return true
	}
	return false
}

function guessExtFromB64(b64: string): string {
	if (b64.indexOf('/9j') == 0) {
		return '.jpg'
	}
	if (b64.indexOf('iVBOR') == 0) {
		return '.png'
	}
	if (b64.indexOf('UklGR') == 0) {
		return '.webp'
	}
	if (b64.indexOf('R0lGOD') == 0) {
		return '.gif'
	}
	return '.jpg'
}
