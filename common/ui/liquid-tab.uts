import { showLiquidTabBar, hideLiquidTabBar, setLiquidTabIndex } from '@/uni_modules/hg-liquid-glass'
import { USE_NATIVE_GLASS } from './glass-config.uts'

const TAB_URLS = [
	'/pages/home/home',
	'/pages/category/category',
	'/pages/search/search',
	'/pages/mine/mine'
]

let attached = false

function hideSystemTabBar(): void {
	// #ifdef APP-IOS || APP-ANDROID
	try {
		uni.hideTabBar({ animation: false })
	} catch (_) { }
	// #endif
}

function openTab(url: string): void {
	uni.switchTab({
		url: url,
		success: (_) => {
			hideSystemTabBar()
			console.log('[liquid-tab] switchTab ok ' + url)
		},
		fail: (err) => {
			console.log('[liquid-tab] switchTab fail ' + JSON.stringify(err))
		}
	})
}

export function installLiquidTabBar(): void {
	// #ifdef APP-ANDROID || APP-IOS
	if (!USE_NATIVE_GLASS) {
		try {
			uni.showTabBar({ animation: false })
		} catch (_) { }
		try {
			hideLiquidTabBar()
		} catch (_) { }
		attached = false
		return
	}

	hideSystemTabBar()

	showLiquidTabBar((index: number): void => {
		const i = Math.floor(index)
		console.log('[liquid-tab] select ' + i)
		if (i < 0 || i >= TAB_URLS.length) {
			return
		}
		openTab(TAB_URLS[i])
	})
	attached = true

	setTimeout(hideSystemTabBar, 120)
	setTimeout(hideSystemTabBar, 500)
	// #endif
}

export function syncLiquidTabIndex(path: string): void {
	// #ifdef APP-ANDROID || APP-IOS
	if (!USE_NATIVE_GLASS) {
		return
	}
	if (!attached) {
		installLiquidTabBar()
	} else {
		hideSystemTabBar()
	}
	let idx = 0
	for (let i = 0; i < TAB_URLS.length; i++) {
		if (path.indexOf(TAB_URLS[i]) >= 0) {
			idx = i
			break
		}
	}
	try {
		setLiquidTabIndex(idx)
	} catch (_) { }
	// #endif
}

export function uninstallLiquidTabBar(): void {
	// #ifdef APP-ANDROID || APP-IOS
	try {
		hideLiquidTabBar()
	} catch (_) { }
	attached = false
	// #endif
}
