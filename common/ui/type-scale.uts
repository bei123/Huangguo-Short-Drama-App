/**
 * 字号缩放（统一成相对 1.0 的比例，再乘设计基准 px）。
 *
 * 查询结论：
 * - getAppBaseInfo.fontSizeScaleFactor / fontSizeSetting：仅微信小程序
 * - App：用 hg-edge.bodyPointSize()（已导出，uts-proxy 可识别）
 *   · iOS = UIFont.body.pointSize
 *   · Android = Configuration.fontScale × 17
 * - 再叠加轻度屏宽系数
 */
import { bodyPointSize } from '@/uni_modules/hg-edge'
import { getWindowWidth, refreshLayout } from './layout.uts'

const BODY_BASE = 17.0
let cachedScale: number = 1.0

export function getTypeScale(): number {
	return cachedScale
}

function clampScale(s: number): number {
	if (s < 0.85) {
		return 0.85
	}
	if (s > 1.35) {
		return 1.35
	}
	return s
}

/** 按逻辑宽度估温和系数 */
function widthScale(): number {
	const w = getWindowWidth()
	if (w <= 0) {
		return 1.0
	}
	if (w < 340) {
		return 0.92
	}
	if (w < 360) {
		return 0.96
	}
	if (w >= 480 && w < 600) {
		return 1.04
	}
	if (w >= 600) {
		return 1.08
	}
	return 1.0
}

function readOsFontScale(): number {
	try {
		const pt = bodyPointSize()
		if (pt > 0) {
			return pt / BODY_BASE
		}
	} catch (e) {
		console.log('[type-scale] bodyPointSize fail ' + e)
	}
	return 1.0
}

export function refreshTypeScale(): number {
	refreshLayout()
	const os = readOsFontScale()
	const byW = widthScale()
	// 系统缩放为主；宽度只做半程微调，避免叠乘过大
	cachedScale = clampScale(os * (1.0 + (byW - 1.0) * 0.5))
	return cachedScale
}

export function scaledPx(base: number): number {
	return Math.round(base * cachedScale)
}

/** 生成 font-size 内联样式，便于绑定到 text */
export function fontStyle(base: number): string {
	return 'font-size:' + scaledPx(base) + 'px'
}
