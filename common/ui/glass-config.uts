/**
 * 液态玻璃总开关（按平台）。
 * iOS：启用原生 UIGlassEffect TabBar（需 Embed unimoduleHgLiquidGlass）。
 * Android：默认关；开真玻璃需含 Liquid-Glass 的自定义基座。
 */

// #ifdef APP-IOS
export const USE_NATIVE_GLASS: boolean = true
export const TAB_BOTTOM_GAP: number = 96
// #endif

// #ifndef APP-IOS
export const USE_NATIVE_GLASS: boolean = false
export const TAB_BOTTOM_GAP: number = 20
// #endif
