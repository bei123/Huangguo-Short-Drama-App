import { publicGet, dynamicGet, userPost, userDelete } from '../http/client.uts'
import { PostCard, PostDetail, PostContentBlock } from '../models/extra.uts'
import { CategoryItem, PageResult } from '../models/video.uts'
import { resolveCoverUrl } from '../http/config.uts'
import { parseCategories } from './parse.uts'

function htmlAttr(tag: string, name: string): string {
	const key = name + '='
	const idx = tag.indexOf(key)
	if (idx < 0) {
		return ''
	}
	const q = tag.charAt(idx + key.length)
	if (q == '"' || q == "'") {
		const start = idx + key.length + 1
		const end = tag.indexOf(q, start)
		if (end > start) {
			return tag.substring(start, end).trim()
		}
		return ''
	}
	// 无引号：读到空白或 >
	const start2 = idx + key.length
	let end2 = start2
	while (end2 < tag.length) {
		const ch = tag.charAt(end2)
		if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '>' || ch == '/') {
			break
		}
		end2++
	}
	return tag.substring(start2, end2).trim()
}

function replaceAll(src: string, from: string, to: string): string {
	if (from.length == 0) {
		return src
	}
	let out = src
	let guard = 0
	while (guard < 2000) {
		const idx = out.indexOf(from)
		if (idx < 0) {
			break
		}
		out = out.substring(0, idx) + to + out.substring(idx + from.length)
		guard++
	}
	return out
}

function decodeEntities(s: string): string {
	let out = s
	out = replaceAll(out, '&nbsp;', ' ')
	out = replaceAll(out, '&lt;', '<')
	out = replaceAll(out, '&gt;', '>')
	out = replaceAll(out, '&amp;', '&')
	out = replaceAll(out, '&quot;', '"')
	out = replaceAll(out, '&#39;', "'")
	return out
}

function htmlToPlain(html: string): string {
	let s = html
	s = replaceAll(s, '<br>', '\n')
	s = replaceAll(s, '<br/>', '\n')
	s = replaceAll(s, '<br />', '\n')
	s = replaceAll(s, '</p>', '\n')
	s = replaceAll(s, '</div>', '\n')
	s = replaceAll(s, '</h1>', '\n')
	s = replaceAll(s, '</h2>', '\n')
	s = replaceAll(s, '</h3>', '\n')
	let guard = 0
	while (guard < 800) {
		const start = s.indexOf('<')
		if (start < 0) {
			break
		}
		const end = s.indexOf('>', start)
		if (end < 0) {
			break
		}
		s = s.substring(0, start) + s.substring(end + 1)
		guard++
	}
	return decodeEntities(s).trim()
}

function isPlaceholderSrc(src: string): boolean {
	if (src.length == 0) {
		return true
	}
	if (src.indexOf('cover-placeholder') >= 0) {
		return true
	}
	if (src.indexOf('/static/web/images/') >= 0) {
		return true
	}
	return false
}

/**
 * 解析图文 HTML：文本与图片分段。
 * 图片优先取 data-src（密文 CDN），交给 hg-cover 解密；跳过占位 src。
 */
export function parsePostContent(html: string): PostContentBlock[] {
	const blocks: PostContentBlock[] = [] as PostContentBlock[]
	if (html.length == 0) {
		return blocks
	}
	let i = 0
	let textBuf = ''
	const lower = html.toLowerCase()

	function flushText() {
		const t = htmlToPlain(textBuf)
		textBuf = ''
		if (t.length > 0) {
			blocks.push({
				kind: 'text',
				text: t,
				src: ''
			} as PostContentBlock)
		}
	}

	while (i < html.length) {
		const imgIdx = lower.indexOf('<img', i)
		if (imgIdx < 0) {
			textBuf += html.substring(i)
			break
		}
		textBuf += html.substring(i, imgIdx)
		flushText()
		const tagEnd = html.indexOf('>', imgIdx)
		if (tagEnd < 0) {
			break
		}
		const tag = html.substring(imgIdx, tagEnd + 1)
		let src = htmlAttr(tag, 'data-src')
		if (src.length == 0) {
			src = htmlAttr(tag, 'data-original')
		}
		if (src.length == 0) {
			const rawSrc = htmlAttr(tag, 'src')
			if (!isPlaceholderSrc(rawSrc)) {
				src = rawSrc
			}
		}
		if (src.length > 0 && !isPlaceholderSrc(src)) {
			blocks.push({
				kind: 'image',
				text: '',
				src: resolveCoverUrl(src)
			} as PostContentBlock)
		}
		i = tagEnd + 1
	}
	flushText()
	return blocks
}

function readNum(obj: UTSJSONObject, key: string, fallback: number = 0): number {
	const n = obj.getNumber(key)
	return n != null ? (n as number) : fallback
}

function readStr(obj: UTSJSONObject, key: string, fallback: string = ''): string {
	const v = obj.getString(key)
	return v != null ? (v as string).trim() : fallback
}

function readTags(obj: UTSJSONObject): string[] {
	const out: string[] = []
	const arr = obj.getArray('tags')
	if (arr == null) {
		return out
	}
	const list = arr as Array<any>
	const limit = Math.min(list.length, 8)
	for (let i = 0; i < limit; i++) {
		out.push(('' + list[i]).trim())
	}
	return out
}

export function parsePostCard(obj: UTSJSONObject): PostCard {
	return {
		id: '' + readNum(obj, 'id', 0),
		title: readStr(obj, 'title', ''),
		cover: resolveCoverUrl(readStr(obj, 'cover', '')),
		hot: readNum(obj, 'hot', 0),
		tags: readTags(obj),
		createdAt: readStr(obj, 'created_at', '')
	} as PostCard
}

function parsePostPage(data: UTSJSONObject): PageResult<PostCard> {
	const items: PostCard[] = []
	const arr = data.getArray('items')
	if (arr != null) {
		const list = arr as Array<any>
		for (let i = 0; i < list.length; i++) {
			items.push(parsePostCard(list[i] as UTSJSONObject))
		}
	}
	const pag = data.getJSON('pagination')
	return {
		items: items,
		page: pag != null ? readNum(pag!, 'page', 1) as number : 1,
		pages: pag != null ? readNum(pag!, 'pages', 1) as number : 1,
		total: pag != null ? readNum(pag!, 'total', items.length) as number : items.length
	} as PageResult<PostCard>
}

export async function fetchPostCategories(): Promise<CategoryItem[]> {
	const res = await publicGet('/api/site/categories/post')
	const data = res.getJSON('data')
	if (data == null) {
		return [] as CategoryItem[]
	}
	return parseCategories(data!) as CategoryItem[]
}

export async function fetchPosts(page: number): Promise<PageResult<PostCard>> {
	const res = await publicGet('/api/posts?page=' + page + '&size=20')
	const data = res.getJSON('data')
	if (data == null) {
		return { items: [] as PostCard[], page: 1, pages: 1, total: 0 } as PageResult<PostCard>
	}
	return parsePostPage(data!)
}

export async function fetchPostsByCategory(route: string, page: number): Promise<PageResult<PostCard>> {
	const res = await publicGet('/api/posts/category/' + encodeURIComponent(route) + '?page=' + page + '&size=20')
	const data = res.getJSON('data')
	if (data == null) {
		return { items: [] as PostCard[], page: 1, pages: 1, total: 0 } as PageResult<PostCard>
	}
	return parsePostPage(data!)
}

export async function fetchPostDetail(id: string): Promise<PostDetail> {
	const res = await dynamicGet('/api/posts/' + encodeURIComponent(id))
	const data = res.getJSON('data')
	if (data == null) {
		throw new Error('post empty')
	}
	let authorId = 0
	let authorName = ''
	let authorAvatar = ''
	const author = data!.getJSON('author')
	if (author != null) {
		authorId = readNum(author!, 'id', 0) as number
		authorName = readStr(author!, 'name', readStr(author!, 'nickname', ''))
		authorAvatar = resolveCoverUrl(readStr(author!, 'avatar', ''))
	}
	let hot = 0
	let like = 0
	let collect = 0
	const counts = data!.getJSON('counts')
	if (counts != null) {
		hot = readNum(counts!, 'hot', 0)
		like = readNum(counts!, 'like', 0)
		collect = readNum(counts!, 'collect', 0)
	}
	let liked = false
	let collected = false
	const interaction = data!.getJSON('interaction')
	if (interaction != null) {
		liked = interaction!.getBoolean('liked') ?? false
		collected = interaction!.getBoolean('collected') ?? false
	}
	let authorFollowing = false
	if (author != null) {
		authorFollowing = author!.getBoolean('is_following') ?? false
	}
	return {
		id: '' + readNum(data!, 'id', 0),
		title: readStr(data!, 'title', ''),
		cover: resolveCoverUrl(readStr(data!, 'cover', '')),
		content: readStr(data!, 'content', ''),
		hot: hot,
		like: like,
		collect: collect,
		tags: readTags(data!),
		authorId: authorId,
		authorName: authorName,
		authorAvatar: authorAvatar,
		liked: liked,
		collected: collected,
		authorFollowing: authorFollowing
	} as PostDetail
}

/** 图文访问埋点（user 档），写入吃瓜历史 HTML（文档 16.4） */
export async function visitPost(id: string): Promise<void> {
	try {
		await userPost('/api/posts/' + encodeURIComponent(id) + '/visit', '{}')
	} catch (e) {
		console.log('[post] visit fail ' + e)
	}
}

export async function likePost(id: string, on: boolean): Promise<boolean> {
	const path = '/api/posts/' + encodeURIComponent(id) + '/like'
	const res = on ? await userPost(path, '{}') : await userDelete(path)
	const data = res.getJSON('data')
	if (data == null) {
		return on
	}
	return data!.getBoolean('liked') ?? on
}

export async function collectPost(id: string, on: boolean): Promise<boolean> {
	const path = '/api/posts/' + encodeURIComponent(id) + '/collect'
	const res = on ? await userPost(path, '{}') : await userDelete(path)
	const data = res.getJSON('data')
	if (data == null) {
		return on
	}
	return data!.getBoolean('collected') ?? on
}

export async function fetchPostAdjacent(id: string): Promise<UTSJSONObject> {
	const res = await publicGet('/api/posts/' + encodeURIComponent(id) + '/adjacent')
	const data = res.getJSON('data')
	return data != null ? data! : ({} as UTSJSONObject)
}
