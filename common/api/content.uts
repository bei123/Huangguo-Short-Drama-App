export async function fetchHotTags(): Promise<TagHot[]> {
	const res = await publicGet('/api/search/tags/hot')
	const data = res.getJSON('data')
	const out: TagHot[] = []
	if (data == null) {
		return out
	}
	const arr = data!.getArray('items')
	if (arr == null) {
		return out
	}
	const list = arr as Array<any>
	for (let i = 0; i < list.length; i++) {
		const it = list[i] as UTSJSONObject
		out.push({
			word: readStr(it, 'name', readStr(it, 'word', '')),
			heat: readNum(it, 'heat', 0)
		} as TagHot)
	}
	return out
}

export async function fetchSuggest(q: string): Promise<SuggestResult> {
	const res = await publicGet('/api/search/suggest?q=' + encodeURIComponent(q))
	const data = res.getJSON('data')
	const words: string[] = []
	const tags: string[] = []
	const content: VideoCard[] = []
	if (data == null) {
		return { words: words, tags: tags, content: content } as SuggestResult
	}
	const items = data!.getArray('items')
	if (items != null) {
		const list = items as Array<any>
		for (let i = 0; i < list.length; i++) {
			words.push(('' + list[i]).trim())
		}
	}
	const tagArr = data!.getArray('tags')
	if (tagArr != null) {
		const list = tagArr as Array<any>
		for (let i = 0; i < list.length; i++) {
			tags.push(('' + list[i]).trim())
		}
	}
	const cArr = data!.getArray('content')
	if (cArr != null) {
		const list = cArr as Array<any>
		for (let i = 0; i < list.length; i++) {
			content.push(parseVideoCard(list[i] as UTSJSONObject))
		}
	}
	return { words: words, tags: tags, content: content } as SuggestResult
}

export async function fetchNextVideo(videoId: string): Promise<VideoCard | null> {
	const res = await dynamicGet('/api/videos/' + encodeURIComponent(videoId) + '/next')
	const data = res.getJSON('data')
	if (data == null) {
		return null
	}
	const item = data!.getJSON('item')
	if (item == null) {
		return null
	}
	return parseVideoCard(item!)
}

