import { publicGet, dynamicGet, userGet } from '../http/client.uts'
import { SortItem, TagHot, SuggestResult } from '../models/extra.uts'
import { PageResult, VideoCard } from '../models/video.uts'
import { parseCardPage, parseVideoCard } from './parse.uts'

function readNum(obj: UTSJSONObject, key: string, fallback: number = 0): number {
	const n = obj.getNumber(key)
	return n != null ? (n as number) : fallback
}

function readStr(obj: UTSJSONObject, key: string, fallback: string = ''): string {
	const v = obj.getString(key)
	return v != null ? (v as string).trim() : fallback
}

export async function fetchSorts(): Promise<SortItem[]> {
	const res = await publicGet('/api/site/sorts/video')
	const data = res.getJSON('data')
	const out: SortItem[] = []
	if (data == null) {
		return out
	}
	const arr = data!.getArray('items')
	if (arr == null) {
		return out
	}
	const list = arr as Array<any>
	for (let i = 0; i < list.length; i++) {
		const it = list[i] as UTSJSONObject
		out.push({
			name: readStr(it, 'name', ''),
			route: readStr(it, 'route', '')
		} as SortItem)
	}
	return out
}

export async function fetchVideosBySort(route: string, page: number): Promise<PageResult<VideoCard>> {
	const res = await publicGet('/api/videos/sort/' + encodeURIComponent(route) + '?page=' + page + '&size=20')
	const data = res.getJSON('data')
	if (data == null) {
		return { items: [] as VideoCard[], page: 1, pages: 1, total: 0 } as PageResult<VideoCard>
	}
	return parseCardPage(data!)
}

