/** 与 hg-edge 共用，改地址后两边都读这个 key */
export const HG_API_BASE_KEY = 'hg_api_base'

/**
 * 线路名单中转（优先）。
 * 手机 → 中转拉官方线路 → 对这些地址测速选最快。
 */
export const HG_ROUTE_RELAYS: string[] = [
	'https://relay.2000gallery.art/routes',
	'https://hg-gohome-relay.zhibei66.workers.dev/routes'
]

/** 中转名单拉不到时的测速兜底 */
export const HG_ENDPOINTS: string[] = [
	'https://d2prlw64zv3q3a.cloudfront.net',
	'https://d2f1636icqru0f.cloudfront.net',
	'https://huangguoai.com'
]

/** CDN 图片 Referer 仍用主站（文档约定） */
export const HG_REFERER = 'https://huangguoai.com/'
export const HG_PIC_CDN = 'https://pic.qnlycc.cn'

/** 默认 API base */
export const HG_DEFAULT_BASE = 'https://huangguoai.com'

let memoryBase = ''

export function normalizeBaseUrl(raw: string): string {
	let s = raw.trim()
	while (s.length > 0 && s.charAt(s.length - 1) == '/') {
		s = s.substring(0, s.length - 1)
	}
	return s
}

export function getHgBaseUrl(): string {
	if (memoryBase.length > 0) {
		return memoryBase
	}
	const cached = uni.getStorageSync(HG_API_BASE_KEY) as string | null
	if (cached != null && cached.length > 0) {
		memoryBase = normalizeBaseUrl(cached as string)
		return memoryBase
	}
	memoryBase = HG_DEFAULT_BASE
	return memoryBase
}

/** 兼容旧常量写法：取值时请优先 getHgBaseUrl() */
export const HG_BASE_URL = HG_DEFAULT_BASE

export function setHgBaseUrl(url: string): boolean {
	const next = normalizeBaseUrl(url)
	if (next.length == 0) {
		return false
	}
	const prev = getHgBaseUrl()
	memoryBase = next
	uni.setStorageSync(HG_API_BASE_KEY, next)
	return prev != next
}

export function resolveCoverUrl(raw: string): string {
	if (raw.length == 0) {
		return ''
	}
	if (raw.indexOf('http://') == 0 || raw.indexOf('https://') == 0) {
		return raw
	}
	if (raw.indexOf('/') == 0) {
		return HG_PIC_CDN + raw
	}
	return HG_PIC_CDN + '/' + raw
}
