<script setup>
	import { installLiquidTabBar } from './common/ui/liquid-tab.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('[app] launch Huangguo Short Drama')
		// Activity 就绪后再挂载原生液态玻璃 TabBar（需自定义基座）
		setTimeout(() => {
			try {
				installLiquidTabBar()
			} catch (e) {
				console.log('[liquid-tab] install fail ' + e)
			}
		}, 400)
	})

	onAppShow(() => {
		console.log('[app] show')
	})

	onAppHide(() => {
		console.log('[app] hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('[app] exit')
	})
	// #endif
</script>

