<template>
	<view class="empty">
		<view class="empty-mark">
			<text class="empty-mark-text">{{mark}}</text>
		</view>
		<text class="empty-title">{{title}}</text>
		<text v-if="desc.length > 0" class="empty-desc">{{desc}}</text>
		<view v-if="action.length > 0" class="empty-btn" @click="onAction">
			<text class="empty-btn-text">{{action}}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	const props = defineProps({
		mark: { type: String, default: '果' },
		title: { type: String, default: '暂无内容' },
		desc: { type: String, default: '' },
		action: { type: String, default: '' }
	})

	const emit = defineEmits(['action'])

	function onAction() {
		emit('action')
	}
</script>

