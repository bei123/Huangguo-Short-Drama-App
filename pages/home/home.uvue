<template>
	<view class="page">
	<!-- #ifdef APP -->
	<scroll-view class="scroll" direction="vertical" @scrolltolower="onScrollLower">
	<!-- #endif -->
		<view class="page-inner">
			<!-- #ifdef APP-IOS -->
			<view class="status-spacer" :style="statusSpacerStyle"></view>
			<!-- #endif -->
			<view class="brand-bar">
				<view class="brand-left">
					<text class="brand" :style="brandFontStyle">黄果</text>
				</view>
				<view class="search-box">
					<input
						class="search-input"
						type="text"
						:value="keyword"
						placeholder="搜索短剧"
						placeholder-style="color:#6F737A"
						confirm-type="search"
						@input="onSearchInput"
						@confirm="doSearch"
					/>
					<text v-if="keyword.length > 0" class="search-clear" @click="clearSearch">清除</text>
					<text class="search-go" @click="doSearch">搜索</text>
				</view>
			</view>

			<!-- 搜索结果态 -->
			<template v-if="searching">
				<view v-if="searchLoading && searchItems.length == 0" class="state-box">
					<text class="state-text">搜索中…</text>
					<hg-skeleton kind="search"></hg-skeleton>
				</view>
				<view v-else-if="searchError.length > 0 && searchItems.length == 0" class="state-box" @click="doSearch">
					<text class="state-text">{{searchError}}</text>
					<text class="state-action">点击重试</text>
				</view>
				<hg-empty
					v-else-if="searchItems.length == 0"
					mark="搜"
					title="没有找到相关作品"
					desc="换个词试试，或清除后继续浏览"
					action="清除搜索"
					@action="clearSearch"
				></hg-empty>
				<view v-else class="result-list">
					<text class="section-title result-head">「{{keyword.trim()}}」的结果</text>
					<view v-for="item in searchItems" :key="item.id" class="result-item" @click="openVideo(item.id)">
						<hg-cover :src="item.cover" :width="84" :height="112" :radius="8"></hg-cover>
						<view class="result-meta">
							<text class="result-title" max-lines="2">{{item.title}}</text>
							<text class="result-sub">评分 {{item.score > 0 ? item.score.toFixed(1) : '-'}} · {{item.episodeCount}}集</text>
							<text class="result-desc" max-lines="2">{{item.desc}}</text>
						</view>
					</view>
					<text v-if="searchLoadingMore" class="footer-tip">加载更多…</text>
					<text v-else-if="!searchHasMore && searchItems.length > 0" class="footer-tip">没有更多了</text>
				</view>
			</template>

			<!-- 首页浏览态 -->
			<template v-else>
				<view v-if="errorText.length > 0" class="state-box" @click="reload">
					<text class="state-text">{{errorText}}</text>
					<text class="state-action">点击重试</text>
				</view>
				<view v-else-if="loading" class="state-box">
					<text class="state-text">{{loadHint}}</text>
					<text v-if="probeHost.length > 0" class="state-sub">{{probeHost}}</text>
					<hg-skeleton kind="home"></hg-skeleton>
				</view>
				<template v-else>
					<view class="quick-row">
						<view class="quick-item quick-rank" hover-class="quick-hover" @click="goRank">
							<view class="quick-badge quick-badge-rank">
								<image class="quick-icon" src="/static/quick/rank.png" mode="aspectFit"></image>
							</view>
							<text class="quick-label">热播榜</text>
						</view>
						<view class="quick-item quick-topic" hover-class="quick-hover" @click="goTopics">
							<view class="quick-badge quick-badge-topic">
								<image class="quick-icon" src="/static/quick/topic.png" mode="aspectFit"></image>
							</view>
							<text class="quick-label">专题</text>
						</view>
						<view class="quick-item quick-item-last quick-latest" hover-class="quick-hover" @click="goLatest">
							<view class="quick-badge quick-badge-latest">
								<image class="quick-icon" src="/static/quick/latest.png" mode="aspectFit"></image>
							</view>
							<text class="quick-label">更新</text>
						</view>
					</view>

					<scroll-view v-if="banners.length > 0" class="banner-row" direction="horizontal" :show-scrollbar="false">
						<view v-for="(b, i) in banners" :key="'bn-' + b.id + '-' + i" class="banner-item" @click="openVideo(b.videoId)">
							<hg-cover :src="b.image" :width="bannerW" :height="bannerH" :radius="14"></hg-cover>
							<view v-if="b.title.length > 0" class="banner-mask">
								<text class="banner-title" max-lines="1">{{b.title}}</text>
							</view>
						</view>
					</scroll-view>

					<view class="section">
						<view class="section-head">
							<text class="section-title" :style="sectionFontStyle">精选推荐</text>
						</view>
						<scroll-view class="row" direction="horizontal" :show-scrollbar="false">
							<hg-video-card
								v-for="item in featured"
								:key="'ft-' + item.id"
								:id="item.id"
								:title="item.title"
								:cover="item.cover"
								:score="item.score"
								:badge="item.badge"
								:sub="epText(item.episodeCount, item.isFinished)"
							></hg-video-card>
						</scroll-view>
					</view>

					<view class="section">
						<view class="section-head">
							<text class="section-title" :style="sectionFontStyle">最近更新</text>
							<text class="section-more" @click="goLatest">更多</text>
						</view>
						<scroll-view class="row" direction="horizontal" :show-scrollbar="false">
							<hg-video-card
								v-for="item in latest"
								:key="'lt-' + item.id"
								:id="item.id"
								:title="item.title"
								:cover="item.cover"
								:score="item.score"
								:badge="item.badge"
								:sub="epText(item.episodeCount, item.isFinished)"
							></hg-video-card>
						</scroll-view>
					</view>

					<view v-if="topicRec.length > 0" class="section">
						<view class="section-head">
							<text class="section-title" :style="sectionFontStyle">精选专题</text>
							<text class="section-more" @click="goTopics">更多</text>
						</view>
						<scroll-view class="topic-row" direction="horizontal" :show-scrollbar="false">
							<view v-for="t in topicRec" :key="'tp-' + t.id" class="topic-item" @click="openTopic(t.slug, t.title)">
								<hg-cover :src="t.cover" :width="168" :height="94" :radius="10"></hg-cover>
								<text class="topic-title">{{t.title}}</text>
								<text class="topic-sub">{{t.videoCount}} 部作品</text>
							</view>
						</scroll-view>
					</view>

					<view v-for="cate in cateRec" :key="'cg-' + cate.cateId" class="section">
						<view class="section-head">
							<text class="section-title" :style="sectionFontStyle">{{cate.cateName}}</text>
						</view>
						<scroll-view class="row" direction="horizontal" :show-scrollbar="false">
							<hg-video-card
								v-for="item in cate.videos"
								:key="'cg-' + cate.cateId + '-' + item.id"
								:id="item.id"
								:title="item.title"
								:cover="item.cover"
								:score="item.score"
								:badge="item.badge"
								:sub="epText(item.episodeCount, item.isFinished)"
							></hg-video-card>
						</scroll-view>
					</view>
				</template>
			</template>
			<view class="bottom-space" :style="bottomGapStyle"></view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
	import { fetchHome, fetchSearch, fetchVideoDetail } from '../../common/api/huangguo.uts'
	import { ensureEndpointReady, onProbeProgress, isProbeDone, ProbeProgress } from '../../common/http/endpoint-probe.uts'
	import { HomeBanner, VideoCard, CateRec, TopicLite } from '../../common/models/video.uts'
	import { installLiquidTabBar, syncLiquidTabIndex } from '../../common/ui/liquid-tab.uts'
	import {
		getWindowWidth, getStatusBarHeight, getTabBottomGap, refreshLayout
	} from '../../common/ui/layout.uts'
	import { refreshTypeScale, fontStyle } from '../../common/ui/type-scale.uts'

	refreshLayout()
	const winW = ref(getWindowWidth())
	const bannerW = ref(winW.value - 32)
	// Banner 实测 1920×640（3:1）；用 0.5 会裁掉左右（任意门标题在左侧）
	const bannerH = ref(Math.floor(bannerW.value / 3))
	const bottomGapStyle = ref('height:' + getTabBottomGap() + 'px')
	const statusSpacerStyle = ref('height:' + getStatusBarHeight() + 'px')
	const brandFontStyle = ref(fontStyle(28))
	const sectionFontStyle = ref(fontStyle(17))

	function syncLayoutStyles() {
		refreshLayout()
		refreshTypeScale()
		winW.value = getWindowWidth()
		bannerW.value = winW.value - 32
		bannerH.value = Math.floor(bannerW.value / 3)
		bottomGapStyle.value = 'height:' + getTabBottomGap() + 'px'
		statusSpacerStyle.value = 'height:' + getStatusBarHeight() + 'px'
		brandFontStyle.value = fontStyle(28)
		sectionFontStyle.value = fontStyle(17)
	}

	function syncTypeStyles() {
		syncLayoutStyles()
	}

	const loading = ref(true)
	const loadHint = ref('正在选择最快线路…')
	const probeHost = ref('')
	const errorText = ref('')
	const banners = ref<HomeBanner[]>([] as HomeBanner[])
	const featured = ref<VideoCard[]>([] as VideoCard[])
	const latest = ref<VideoCard[]>([] as VideoCard[])
	const cateRec = ref<CateRec[]>([] as CateRec[])
	const topicRec = ref<TopicLite[]>([] as TopicLite[])

	onProbeProgress((p: ProbeProgress) => {
		// 内容已出来后不再改提示，避免「探测中」盖在首页上
		if (!loading.value) {
			return
		}
		if (p.phase == 'done') {
			loadHint.value = '加载首页…'
			if (p.bestHost.length > 0) {
				probeHost.value = p.bestHost + (p.bestMs > 0 ? (' · ' + p.bestMs + 'ms') : '')
			}
			return
		}
		loadHint.value = p.message.length > 0 ? p.message : '正在选择最快线路…'
		if (p.bestHost.length > 0) {
			probeHost.value = p.bestHost + (p.bestMs > 0 ? (' · ' + p.bestMs + 'ms') : '')
		}
	})

	const keyword = ref('')
	const searching = ref(false)
	const searchLoading = ref(false)
	const searchLoadingMore = ref(false)
	const searchError = ref('')
	const searchItems = ref<VideoCard[]>([] as VideoCard[])
	const searchPage = ref(1)
	const searchPages = ref(1)

	const searchHasMore = computed((): boolean => {
		return searchPage.value < searchPages.value
	})

	function epText(count: number, finished: boolean): string {
		if (count <= 0) {
			return ''
		}
		return finished ? count + '集全' : '更新至' + count + '集'
	}

	function openVideo(id: string) {
		if (id.length == 0 || id == '0') {
			return
		}
		uni.navigateTo({
			url: '/pages/detail/detail?id=' + encodeURIComponent(id)
		})
	}

	function goLatest() {
		uni.navigateTo({
			url: '/pages/list/list?mode=latest&title=' + encodeURIComponent('最近更新')
		})
	}

	function goTopics() {
		uni.navigateTo({ url: '/pages/topics/topics' })
	}

	function goRank() {
		uni.navigateTo({
			url: '/pages/rank/rank?type=hot&title=' + encodeURIComponent('热播榜')
		})
	}

	function openTopic(slug: string, title: string) {
		uni.navigateTo({
			url: '/pages/topic-detail/topic-detail?slug=' + encodeURIComponent(slug) + '&title=' + encodeURIComponent(title)
		})
	}

	function onSearchInput(e: UniInputEvent) {
		keyword.value = e.detail.value
	}

	function clearSearch() {
		keyword.value = ''
		searching.value = false
		searchItems.value = [] as VideoCard[]
		searchError.value = ''
		searchPage.value = 1
		searchPages.value = 1
	}

	async function doSearch() {
		const q = keyword.value.trim()
		if (q.length == 0) {
			uni.showToast({ title: '请输入关键词', icon: 'none' })
			return
		}
		searching.value = true
		searchLoading.value = true
		searchError.value = ''
		searchItems.value = [] as VideoCard[]
		searchPage.value = 1
		try {
			const res = await fetchSearch(q, 1)
			searchItems.value = res.items
			searchPage.value = res.page
			searchPages.value = res.pages
		} catch (e) {
			searchError.value = '搜索失败，点击重试'
			console.log('[home] search fail ' + e)
		} finally {
			searchLoading.value = false
		}
	}

	async function loadMoreSearch() {
		if (!searching.value || !searchHasMore.value || searchLoadingMore.value || searchLoading.value) {
			return
		}
		searchLoadingMore.value = true
		try {
			const next = searchPage.value + 1
			const res = await fetchSearch(keyword.value.trim(), next)
			const merged = searchItems.value.slice(0)
			for (let i = 0; i < res.items.length; i++) {
				merged.push(res.items[i])
			}
			searchItems.value = merged
			searchPage.value = res.page
			searchPages.value = res.pages
		} catch (e) {
			console.log('[home] search more fail ' + e)
		} finally {
			searchLoadingMore.value = false
		}
	}

	function onScrollLower() {
		if (searching.value) {
			loadMoreSearch()
		}
	}

	function findCardTitle(cards: VideoCard[], videoId: string): string {
		for (let i = 0; i < cards.length; i++) {
			if (cards[i].id == videoId) {
				return cards[i].title
			}
		}
		return ''
	}

	function lookupBannerTitle(
		videoId: string,
		featuredList: VideoCard[],
		latestList: VideoCard[],
		cates: CateRec[]
	): string {
		let t = findCardTitle(featuredList, videoId)
		if (t.length > 0) {
			return t
		}
		t = findCardTitle(latestList, videoId)
		if (t.length > 0) {
			return t
		}
		for (let i = 0; i < cates.length; i++) {
			t = findCardTitle(cates[i].videos, videoId)
			if (t.length > 0) {
				return t
			}
		}
		return ''
	}

	function fillBannerTitlesLocal(
		list: HomeBanner[],
		featuredList: VideoCard[],
		latestList: VideoCard[],
		cates: CateRec[]
	): HomeBanner[] {
		const out: HomeBanner[] = [] as HomeBanner[]
		for (let i = 0; i < list.length; i++) {
			const b = list[i]
			let title = b.title
			if (title.length == 0) {
				title = lookupBannerTitle(b.videoId, featuredList, latestList, cates)
			}
			out.push({
				id: b.id,
				videoId: b.videoId,
				title: title,
				image: b.image,
				score: b.score,
				desc: b.desc
			} as HomeBanner)
		}
		return out
	}

	// 本地列表对不上的 Banner，再拉详情补剧名（不挡首屏）
	async function fillBannerTitlesRemote(list: HomeBanner[]) {
		const need: number[] = [] as number[]
		for (let i = 0; i < list.length; i++) {
			if (list[i].title.length == 0 && list[i].videoId.length > 0 && list[i].videoId != '0') {
				need.push(i)
			}
		}
		if (need.length == 0) {
			return
		}
		const next = list.slice(0)
		for (let n = 0; n < need.length; n++) {
			const idx = need[n]
			try {
				const detail = await fetchVideoDetail(next[idx].videoId)
				if (detail.title.length > 0) {
					next[idx] = {
						id: next[idx].id,
						videoId: next[idx].videoId,
						title: detail.title,
						image: next[idx].image,
						score: next[idx].score,
						desc: next[idx].desc
					} as HomeBanner
				}
			} catch (e) {
				console.log('[home] banner title fail ' + next[idx].videoId + ' ' + e)
			}
		}
		banners.value = next
	}

	async function reload() {
		// 已有内容时不要 loading=true，否则整表卸载会触发 Vapor itemId 空指针
		const soft = featured.value.length > 0 || latest.value.length > 0 || banners.value.length > 0
		if (!soft) {
			loading.value = true
		}
		errorText.value = ''
		loadHint.value = isProbeDone() ? '加载首页…' : '正在选择最快线路…'
		try {
			await ensureEndpointReady()
			loadHint.value = '加载首页…'
			const data = await fetchHome()
			featured.value = data.featured
			latest.value = data.latest
			const cates: CateRec[] = [] as CateRec[]
			for (let i = 0; i < data.cateRec.length; i++) {
				const cn = data.cateRec[i].cateName
				if (cn.indexOf('魔改') >= 0 || cn.indexOf('换脸') >= 0) {
					continue
				}
				cates.push(data.cateRec[i])
			}
			// 首屏先挂 2 行分类，其余空闲再补，减轻封面解密洪峰
			const firstBatch: CateRec[] = [] as CateRec[]
			const restBatch: CateRec[] = [] as CateRec[]
			for (let i = 0; i < cates.length; i++) {
				if (i < 2) {
					firstBatch.push(cates[i])
				} else {
					restBatch.push(cates[i])
				}
			}
			cateRec.value = firstBatch
			topicRec.value = data.topicRec
			const filled = fillBannerTitlesLocal(data.banners, data.featured, data.latest, cates)
			banners.value = filled
			fillBannerTitlesRemote(filled)
			if (restBatch.length > 0) {
				setTimeout(() => {
					const merged = cateRec.value.slice(0)
					for (let i = 0; i < restBatch.length; i++) {
						merged.push(restBatch[i])
					}
					cateRec.value = merged
				}, 80)
			}
		} catch (e) {
			errorText.value = '首页加载失败，点击重试'
			console.log('[home] fail ' + e)
		} finally {
			loading.value = false
		}
	}

	onLoad(() => {
		reload()
	})

	onShow(() => {
		syncTypeStyles()
		try {
			installLiquidTabBar()
			syncLiquidTabIndex('/pages/home/home')
		} catch (_) { }
	})

	onPullDownRefresh(() => {
		if (searching.value) {
			doSearch().then(() => {
				uni.stopPullDownRefresh()
			})
		} else {
			reload().then(() => {
				uni.stopPullDownRefresh()
			})
		}
	})
</script>

<style>
	.page {
		flex: 1;
		background-color: #12141a;
	}

	.scroll {
		flex: 1;
	}

	.page-inner {
		padding-left: 16px;
		padding-right: 16px;
		padding-top: 8px;
		background-color: #12141a;
	}

	.brand-bar {
		flex-direction: row;
		align-items: center;
		padding-top: 4px;
		padding-bottom: 14px;
	}

	.brand-left {
		margin-right: 12px;
	}

	.brand {
		color: #E8C27A;
		font-size: 24px;
		font-weight: bold;
		letter-spacing: 1px;
	}

	.search-box {
		flex: 1;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding-left: 14px;
		padding-right: 6px;
		background-color: #181B22;
		border-radius: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #2A2E38;
	}

	.search-input {
		flex: 1;
		height: 36px;
		color: #F2F3F5;
		font-size: 14px;
	}

	.search-clear {
		color: #6F737A;
		font-size: 12px;
		margin-right: 8px;
		padding: 4px;
	}

	.search-go {
		color: #1A1208;
		font-size: 12px;
		font-weight: bold;
		padding: 6px 12px;
		background-color: #E8C27A;
		border-radius: 8px;
	}

	.state-box {
		padding-top: 88px;
		align-items: center;
	}

	.state-sub {
		margin-top: 8px;
		color: #E8C27A;
		font-size: 12px;
	}

	.state-text {
		color: #8A8E96;
		font-size: 14px;
		text-align: center;
	}

	.state-action {
		margin-top: 12px;
		color: #E8C27A;
		font-size: 13px;
	}

	.quick-row {
		flex-direction: row;
		margin-bottom: 18px;
	}

	.quick-item {
		flex: 1;
		flex-direction: row;
		align-items: center;
		padding: 12px 10px;
		margin-right: 8px;
		background-color: #181B22;
		border-radius: 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #2A2E38;
	}

	.quick-rank {
		background-color: #1C1416;
		border-color: #3A2428;
	}

	.quick-topic {
		background-color: #171A22;
		border-color: #2A2E38;
	}

	.quick-latest {
		background-color: #171C1A;
		border-color: #2A3430;
	}

	.quick-item-last {
		margin-right: 0;
	}

	.quick-hover {
		opacity: 0.88;
	}

	.quick-badge {
		width: 32px;
		height: 32px;
		border-radius: 10px;
		align-items: center;
		justify-content: center;
		margin-right: 8px;
	}

	.quick-badge-rank {
		background-color: #2A181A;
	}

	.quick-badge-topic {
		background-color: #22262F;
	}

	.quick-badge-latest {
		background-color: #1E2A24;
	}

	.quick-icon {
		width: 20px;
		height: 20px;
