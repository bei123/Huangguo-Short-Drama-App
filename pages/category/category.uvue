		color: #E8C27A;
		font-size: 13px;
	}

	/* #ifdef APP-IOS */
	.status-spacer {
		width: 100%;
	}
	.page-title {
		font-size: 28px;
	}
	.page-desc {
		font-size: 15px;
	}
	.section-title {
		font-size: 17px;
	}
	.rank-cell {
		min-height: 96px;
		padding: 16px 12px;
	}
	.cate-chip {
		min-height: 44px;
		padding: 14px 14px;
	}
	.channel {
		padding: 16px 14px;
		min-height: 44px;
	}
	/* #endif */
</style>
