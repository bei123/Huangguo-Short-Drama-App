<template>
	<!-- #ifdef APP -->
	<scroll-view class="page" direction="vertical">
	<!-- #endif -->
		<view class="page-inner" :style="pagePadStyle">
			<!-- #ifdef APP-IOS -->
			<view class="status-spacer" :style="statusSpacerStyle"></view>
			<!-- #endif -->

			<view class="hero">
				<text class="page-title" :style="titleFontStyle">发现</text>
				<text class="page-desc">按分类逛剧 · 榜单与频道</text>
			</view>

			<!-- 榜单：横向主入口 -->
			<view class="rank-strip">
				<view class="rank-cell rank-hot" hover-class="rank-press" @click="openRank('hot', '热播榜')">
					<image class="rank-icon" src="/static/quick/rank.png" mode="aspectFit"></image>
					<text class="rank-name">热播榜</text>
					<text class="rank-hint">本周热力</text>
				</view>
				<view class="rank-cell rank-rec" hover-class="rank-press" @click="openRank('recommend', '推荐榜')">
					<image class="rank-icon" src="/static/quick/pick.png" mode="aspectFit"></image>
					<text class="rank-name">推荐榜</text>
					<text class="rank-hint rank-hint-rec">口碑精选</text>
				</view>
				<view class="rank-cell rank-pot rank-cell-last" hover-class="rank-press" @click="openRank('potential', '潜力榜')">
					<image class="rank-icon" src="/static/quick/potential.png" mode="aspectFit"></image>
					<text class="rank-name">潜力榜</text>
					<text class="rank-hint rank-hint-pot">新作崛起</text>
				</view>
			</view>

			<!-- 分类 -->
			<view class="section-head">
				<text class="section-title">内容分类</text>
				<text class="section-sub">{{cateHint}}</text>
			</view>

			<view v-if="loading" class="state-box">
				<text class="state-text">{{loadHint}}</text>
			</view>
			<view v-else-if="errorText.length > 0" class="state-box" @click="reload">
				<text class="state-text">{{errorText}}</text>
				<text class="state-action">点击重试</text>
			</view>
			<hg-empty
				v-else-if="categories.length == 0"
				mark="类"
				title="暂无分类"
				desc="稍后再来看看"
			></hg-empty>
			<view v-else class="cate-wrap">
				<view
					v-for="(c, idx) in categories"
					:key="c.id"
					class="cate-chip"
					:class="'cate-tone-' + (idx % 5)"
					hover-class="cate-press"
					@click="openCategory(c.route, c.name)"
				>
					<view class="cate-mark">
						<image class="cate-icon" src="/static/quick/cate.png" mode="aspectFit"></image>
					</view>
					<text class="cate-name" max-lines="1">{{c.name}}</text>
					<text class="cate-go">›</text>
				</view>
			</view>

			<!-- 频道入口 -->
			<view class="section-head section-head-gap">
				<text class="section-title">频道</text>
				<text class="section-sub">专题 · 资讯 · 专区</text>
			</view>
			<view class="channel-grid">
				<view class="channel" hover-class="channel-press" @click="goTopics">
					<image class="channel-icon" src="/static/quick/topic.png" mode="aspectFit"></image>
					<text class="channel-name">专题合集</text>
					<text class="channel-desc">人工编排专辑</text>
				</view>
				<view class="channel channel-even" hover-class="channel-press" @click="goPosts">
					<image class="channel-icon" src="/static/quick/posts.png" mode="aspectFit"></image>
					<text class="channel-name">图文资讯</text>
					<text class="channel-desc">剧评与幕后</text>
				</view>
				<view class="channel" hover-class="channel-press" @click="goFeed">
					<image class="channel-icon" src="/static/quick/feed.png" mode="aspectFit"></image>
					<text class="channel-name">推荐信息流</text>
					<text class="channel-desc">今日推荐</text>
				</view>
				<view class="channel channel-even" hover-class="channel-press" @click="goOriginal">
					<image class="channel-icon" src="/static/quick/original.png" mode="aspectFit"></image>
					<text class="channel-name">原创专区</text>
					<text class="channel-desc">原创短剧</text>
				</view>
				<view class="channel" hover-class="channel-press" @click="goLong">
					<image class="channel-icon" src="/static/quick/long.png" mode="aspectFit"></image>
					<text class="channel-name">长视频</text>
					<text class="channel-desc">更长篇幅</text>
				</view>
				<view class="channel channel-even" hover-class="channel-press" @click="goSort('new', '最近更新')">
					<image class="channel-icon" src="/static/quick/latest.png" mode="aspectFit"></image>
					<text class="channel-name">最近更新</text>
					<text class="channel-desc">按时间浏览</text>
				</view>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { fetchCategories } from '../../common/api/huangguo.uts'
	import { CategoryItem } from '../../common/models/video.uts'
	import { installLiquidTabBar, syncLiquidTabIndex } from '../../common/ui/liquid-tab.uts'
	import { TAB_BOTTOM_GAP } from '../../common/ui/glass-config.uts'
	import { refreshTypeScale, fontStyle } from '../../common/ui/type-scale.uts'
	import { ensureEndpointReady, isProbeDone } from '../../common/http/endpoint-probe.uts'

	const pagePadStyle = 'padding: 12px 16px ' + TAB_BOTTOM_GAP + 'px 16px'
	const statusSpacerStyle = 'height:' + uni.getWindowInfo().statusBarHeight + 'px'
	const titleFontStyle = ref(fontStyle(28))

	const categories = ref<CategoryItem[]>([] as CategoryItem[])
	const loading = ref(true)
	const loadHint = ref('正在选择最快线路…')
	const errorText = ref('')
	const cateHint = computed((): string => {
		const n = categories.value.length
		if (loading.value) {
			return '加载中'
		}
		if (n <= 0) {
			return '暂无'
		}
		return n + ' 个分类'
	})

	function openCategory(route: string, name: string) {
		uni.navigateTo({
			url: '/pages/list/list?mode=category&route=' + encodeURIComponent(route) + '&title=' + encodeURIComponent(name)
		})
	}

	function openRank(type: string, title: string) {
		uni.navigateTo({
			url: '/pages/rank/rank?type=' + encodeURIComponent(type) + '&title=' + encodeURIComponent(title)
		})
	}

	function goTopics() { uni.navigateTo({ url: '/pages/topics/topics' }) }
	function goPosts() { uni.navigateTo({ url: '/pages/posts/posts' }) }
	function goFeed() { uni.navigateTo({ url: '/pages/feed/feed' }) }
	function goOriginal() {
		uni.navigateTo({ url: '/pages/list/list?mode=original&title=' + encodeURIComponent('原创专区') })
	}
	function goLong() {
		uni.navigateTo({ url: '/pages/list/list?mode=long&title=' + encodeURIComponent('长视频') })
	}
	function goSort(route: string, title: string) {
		uni.navigateTo({
			url: '/pages/list/list?mode=sort&route=' + encodeURIComponent(route) + '&title=' + encodeURIComponent(title)
		})
	}

	/** AI魔改 / AI换脸已下线，不展示 */
	function isOfflineCategory(c: CategoryItem): boolean {
		const r = c.route
		const n = c.name
		if (r == 'ai-mogai' || r == 'ai-huanlian') {
			return true
		}
		if (n.indexOf('魔改') >= 0 || n.indexOf('换脸') >= 0) {
			return true
		}
		return false
	}

	function reload() {
		loading.value = true
		errorText.value = ''
		loadHint.value = isProbeDone() ? '加载分类…' : '正在选择最快线路…'
		ensureEndpointReady().then(() => {
			loadHint.value = '加载分类…'
			return fetchCategories()
		}).then((list) => {
			const kept: CategoryItem[] = [] as CategoryItem[]
			for (let i = 0; i < list.length; i++) {
				if (!isOfflineCategory(list[i])) {
					kept.push(list[i])
				}
			}
			categories.value = kept
			loading.value = false
		}).catch((e) => {
			errorText.value = '分类加载失败'
			loading.value = false
			console.log('[category] fail ' + e)
		})
	}

	onLoad(() => {
		reload()
	})

	onShow(() => {
		refreshTypeScale()
		titleFontStyle.value = fontStyle(28)
		try {
			installLiquidTabBar()
			syncLiquidTabIndex('/pages/category/category')
		} catch (_) { }
	})
</script>

<style>
	.page {
		flex: 1;
		background-color: #12141a;
	}

	.page-inner {
		padding: 12px 16px;
	}

	.hero {
		margin-bottom: 18px;
	}

	.page-title {
		color: #E8C27A;
		font-size: 26px;
		font-weight: bold;
	}

	.page-desc {
		margin-top: 6px;
		color: #8A8E96;
		font-size: 13px;
	}

	.rank-strip {
		flex-direction: row;
		margin-bottom: 22px;
	}

	.rank-cell {
		flex: 1;
		border-radius: 14px;
		padding: 14px 10px;
		margin-right: 8px;
		min-height: 88px;
		justify-content: flex-end;
	}

	.rank-cell-last {
		margin-right: 0;
	}

	.rank-hot {
		background-color: #2A2218;
		border-width: 1px;
		border-style: solid;
		border-color: #4A3A22;
	}

	.rank-rec {
		background-color: #1A2230;
		border-width: 1px;
		border-style: solid;
		border-color: #2A3848;
	}

	.rank-pot {
		background-color: #1C2620;
		border-width: 1px;
		border-style: solid;
		border-color: #2A4034;
	}

	.rank-press {
		opacity: 0.82;
	}

	.rank-icon {
		width: 28px;
		height: 28px;
		margin-bottom: 10px;
	}

	.rank-name {
		color: #F2F3F5;
		font-size: 15px;
		font-weight: bold;
	}

	.rank-hint {
		margin-top: 4px;
		color: #A09070;
		font-size: 11px;
	}

	.rank-hint-rec {
		color: #7A9EC8;
	}

	.rank-hint-pot {
		color: #7AC8A0;
	}

	.section-head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.section-head-gap {
		margin-top: 8px;
	}

	.section-title {
		color: #F2F3F5;
		font-size: 16px;
		font-weight: bold;
	}

	.section-sub {
		color: #6F737A;
		font-size: 12px;
	}

	.cate-wrap {
		margin-bottom: 20px;
	}

	.cate-chip {
		flex-direction: row;
		align-items: center;
		background-color: #1A1D26;
		border-radius: 12px;
		padding: 12px 12px;
		margin-bottom: 8px;
