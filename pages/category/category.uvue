	}

	.channel {
		width: 48%;
		margin-right: 4%;
		margin-bottom: 10px;
		background-color: #1A1D26;
		border-radius: 12px;
		padding: 14px 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #242830;
	}

	.channel-even {
		margin-right: 0;
	}

	.channel-press {
		background-color: #22262F;
	}

	.channel-icon {
		width: 22px;
		height: 22px;
		margin-bottom: 10px;
	}

	.channel-name {
		color: #F2F3F5;
		font-size: 14px;
		font-weight: bold;
	}

	.channel-desc {
		margin-top: 4px;
		color: #6F737A;
		font-size: 11px;
	}

	.state-box {
		padding-top: 24px;
		padding-bottom: 24px;
		align-items: center;
		margin-bottom: 12px;
	}

	.state-text {
		color: #8A8E96;
		font-size: 13px;
	}

	.state-action {
