		border-style: solid;
		border-color: #242830;
	}

	.cate-tone-0 { border-left-width: 3px; border-left-color: #E8C27A; }
	.cate-tone-1 { border-left-width: 3px; border-left-color: #7A9EC8; }
	.cate-tone-2 { border-left-width: 3px; border-left-color: #C89A7A; }
	.cate-tone-3 { border-left-width: 3px; border-left-color: #7AC8A0; }
	.cate-tone-4 { border-left-width: 3px; border-left-color: #B07AC8; }

	.cate-press {
		background-color: #22262F;
	}

	.cate-mark {
		width: 36px;
