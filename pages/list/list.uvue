<template>
	<!-- #ifdef APP -->
	<scroll-view class="page" direction="vertical" @scrolltolower="loadMore">
	<!-- #endif -->
		<view class="page-inner">
			<view v-if="loading && items.length == 0" class="state-box">
				<text class="state-text">加载中…</text>
			</view>
			<view v-else-if="errorText.length > 0 && items.length == 0" class="state-box" @click="reload">
				<text class="state-text">{{errorText}}</text>
				<text class="state-action">点击重试</text>
			</view>
			<hg-empty v-else-if="items.length == 0" mark="空" title="暂无内容"></hg-empty>
			<view v-else class="grid">
				<view v-for="item in items" :key="item.id" class="grid-card">
					<hg-video-card
						:id="item.id"
						:title="item.title"
						:cover="item.cover"
						:score="item.score"
						:badge="item.badge"
						:sub="item.episodeCount + '集'"
						:cover-w="cardW"
						:cover-h="cardH"
						:tight="true"
					></hg-video-card>
				</view>
			</view>
			<text v-if="loadingMore" class="footer-tip">加载更多…</text>
			<text v-else-if="!hasMore && items.length > 0" class="footer-tip">没有更多了</text>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { fetchLatest, fetchCategoryVideos } from '../../common/api/huangguo.uts'
	import {
		fetchVideosBySort, fetchOriginalVideos, fetchLongVideos,
		fetchVideosByTag, fetchAllVideos
	} from '../../common/api/content.uts'
	import { VideoCard } from '../../common/models/video.uts'

	const mode = ref('latest')
	const route = ref('')
	const loading = ref(true)
	const loadingMore = ref(false)
	const errorText = ref('')
	const items = ref<VideoCard[]>([] as VideoCard[])
	const page = ref(1)
	const pages = ref(1)
	const winW = uni.getWindowInfo().windowWidth
	const cardW = Math.floor((winW - 16 - 16 - 16) / 3)
	const cardH = Math.floor(cardW * 1.36)

	const hasMore = computed((): boolean => {
		return page.value < pages.value
	})

	async function fetchPage(p: number): Promise<VideoCard[]> {
		if (mode.value == 'category') {
			const res = await fetchCategoryVideos(route.value, p, 20)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		if (mode.value == 'sort') {
			const res = await fetchVideosBySort(route.value.length > 0 ? route.value : 'new', p)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		if (mode.value == 'original') {
			const res = await fetchOriginalVideos(p)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		if (mode.value == 'long') {
			const res = await fetchLongVideos(p)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		if (mode.value == 'tag') {
			const res = await fetchVideosByTag(route.value, p)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		if (mode.value == 'all') {
			const res = await fetchAllVideos(p)
			page.value = res.page
			pages.value = res.pages
			return res.items
		}
		const res = await fetchLatest(p)
		page.value = res.page
		pages.value = res.pages
		return res.items
	}

	async function reload() {
		loading.value = true
		errorText.value = ''
		items.value = [] as VideoCard[]
		try {
			items.value = await fetchPage(1)
		} catch (e) {
			errorText.value = '加载失败，点击重试'
			console.log('[list] fail ' + e)
		} finally {
			loading.value = false
		}
	}

	async function loadMore() {
		if (!hasMore.value || loadingMore.value || loading.value) {
			return
		}
		loadingMore.value = true
		try {
			const nextItems = await fetchPage(page.value + 1)
			const merged = items.value.slice(0)
			for (let i = 0; i < nextItems.length; i++) {
				merged.push(nextItems[i])
			}
			items.value = merged
		} catch (e) {
			console.log('[list] more fail ' + e)
		} finally {
			loadingMore.value = false
		}
	}

	onLoad((options) => {
		mode.value = options['mode'] ?? 'latest'
		route.value = options['route'] ?? ''
		const title = options['title'] ?? '列表'
		uni.setNavigationBarTitle({ title: title })
		reload()
	})
</script>

<style>
	.page { flex: 1; background-color: #12141a; }
	.page-inner { padding: 14px 16px 28px 16px; }
	.state-box { padding-top: 72px; align-items: center; padding-left: 24px; padding-right: 24px; }
	.state-text { color: #8A8E96; font-size: 14px; text-align: center; }
	.state-action { margin-top: 12px; color: #E8C27A; font-size: 13px; }
	.grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
	.grid-card { width: 31%; margin-bottom: 16px; }
	.footer-tip { text-align: center; color: #6F737A; font-size: 12px; padding: 12px; }
</style>
