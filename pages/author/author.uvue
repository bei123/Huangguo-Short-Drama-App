<template>
	<!-- #ifdef APP -->
	<scroll-view class="page" direction="vertical" @scrolltolower="loadMore">
	<!-- #endif -->
		<view class="page-inner">
			<view v-if="loading" class="state-box">
				<text class="state-text">加载中…</text>
			</view>
			<template v-else-if="profile != null">
				<view class="head">
					<view class="avatar" :style="{ backgroundColor: profile!.avatarColor }">
						<text class="avatar-text">{{avatarLetter}}</text>
					</view>
					<view class="head-meta">
						<text class="name">{{profile!.nickname}}</text>
						<text class="sign">{{profile!.sign.length > 0 ? profile!.sign : profile!.desc}}</text>
					</view>
					<text class="follow-btn" @click="toggleFollow">{{following ? '已关注' : '关注'}}</text>
				</view>
				<view class="stats">
					<text class="stat">粉丝 {{profile!.followers}}</text>
					<text class="stat">视频 {{profile!.videoCount}}</text>
					<text class="stat">图文 {{profile!.postCount}}</text>
					<text class="stat">获赞 {{formatHot(profile!.likeCount)}}</text>
				</view>

				<view class="tabs">
					<text class="tab" :class="tab == 'video' ? 'tab-on' : ''" @click="switchTab('video')">视频 {{profile!.videoCount}}</text>
					<text class="tab" :class="tab == 'post' ? 'tab-on' : ''" @click="switchTab('post')">帖子 {{profile!.postCount}}</text>
				</view>

				<view v-if="tab == 'video'" class="grid">
					<view v-for="item in videos" :key="item.id" class="grid-card">
						<hg-video-card
							:id="item.id"
							:title="item.title"
							:cover="item.cover"
							:score="item.score"
							:badge="item.badge"
							:sub="item.episodeCount + '集'"
							:cover-w="110"
							:cover-h="150"
						></hg-video-card>
					</view>
				</view>
				<view v-else>
					<view v-for="it in posts" :key="it.id" class="post-row" @click="openPost(it.id)">
						<hg-cover :src="it.cover" :width="88" :height="62" :radius="6"></hg-cover>
						<view class="post-meta">
							<text class="post-title">{{it.title}}</text>
							<text class="post-sub">热度 {{formatHot(it.hot)}}</text>
						</view>
					</view>
					<text v-if="posts.length == 0" class="empty">暂无帖子</text>
				</view>
			</template>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { fetchAuthor, fetchAuthorVideos, fetchAuthorPosts } from '../../common/api/author.uts'
	import { followUser } from '../../common/api/interact.uts'
	import { AuthorProfile, PostCard } from '../../common/models/extra.uts'
	import { VideoCard } from '../../common/models/video.uts'
	import { isLoggedIn } from '../../common/auth/session.uts'

	const uid = ref(0)
	const loading = ref(true)
	const profile = ref<AuthorProfile | null>(null)
	const videos = ref<VideoCard[]>([] as VideoCard[])
	const posts = ref<PostCard[]>([] as PostCard[])
	const following = ref(false)
	const tab = ref('video')
	const page = ref(1)
	const pages = ref(1)
	const postsLoaded = ref(false)
	const avatarLetter = ref('作')

	function formatHot(n: number): string {
		if (n >= 10000) {
			return (n / 10000).toFixed(1) + '万'
		}
		return '' + n
	}

	async function loadVideos(p: number) {
		const res = await fetchAuthorVideos(uid.value, p)
		if (p == 1) {
			videos.value = res.items
		} else {
			const merged = videos.value.slice(0)
			for (let i = 0; i < res.items.length; i++) {
				merged.push(res.items[i])
			}
			videos.value = merged
		}
		page.value = res.page
		pages.value = res.pages
	}

	async function loadPosts(p: number) {
		const res = await fetchAuthorPosts(uid.value, p, 'hot')
		if (p == 1) {
			posts.value = res.items
		} else {
			const merged = posts.value.slice(0)
			for (let i = 0; i < res.items.length; i++) {
				merged.push(res.items[i])
			}
			posts.value = merged
		}
		page.value = res.page
		pages.value = res.pages
		postsLoaded.value = true
	}

	async function reload() {
		loading.value = true
		try {
			const p = await fetchAuthor(uid.value)
			profile.value = p
			following.value = p.isFollowing
			avatarLetter.value = p.nickname.length > 0 ? p.nickname.substring(0, 1) : '作'
			uni.setNavigationBarTitle({ title: p.nickname })
			// 有视频优先视频 Tab，否则默认帖子
			if (p.videoCount > 0 || p.postCount == 0) {
				tab.value = 'video'
				await loadVideos(1)
			} else {
				tab.value = 'post'
				await loadPosts(1)
			}
		} catch (e) {
			console.log('[author] ' + e)
		} finally {
			loading.value = false
		}
	}

	async function switchTab(t: string) {
		tab.value = t
		page.value = 1
		pages.value = 1
		if (t == 'post') {
			if (!postsLoaded.value) {
				await loadPosts(1)
			}
		} else if (videos.value.length == 0) {
			await loadVideos(1)
		}
	}

	async function loadMore() {
		if (page.value >= pages.value) {
			return
		}
		try {
			if (tab.value == 'post') {
				await loadPosts(page.value + 1)
			} else {
				await loadVideos(page.value + 1)
			}
		} catch (_) { }
	}

	async function toggleFollow() {
		if (!isLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		try {
			following.value = await followUser(uid.value, !following.value)
		} catch (e) {
			uni.showToast({ title: '' + e, icon: 'none' })
		}
	}

	function openPost(id: string) {
		uni.navigateTo({ url: '/pages/post-detail/post-detail?id=' + encodeURIComponent(id) })
	}

	onLoad((options) => {
		uid.value = parseFloat(options['id'] ?? '0') as number
		reload()
	})
</script>

<style>
	.page { flex: 1; background-color: #12141a; }
	.page-inner { padding: 14px 10px 24px 10px; }
	.state-box { padding-top: 80px; align-items: center; }
	.state-text { color: #9aa0aa; font-size: 14px; }
	.head { flex-direction: row; align-items: center; padding: 0 4px 12px 4px; }
	.avatar {
		width: 52px; height: 52px; border-radius: 26px;
		align-items: center; justify-content: center;
	}
	.avatar-text { color: #fff; font-size: 20px; font-weight: bold; }
	.head-meta { flex: 1; margin-left: 12px; }
	.name { color: #f5f5f5; font-size: 18px; font-weight: bold; }
	.sign { margin-top: 4px; color: #8a8e96; font-size: 12px; }
	.follow-btn {
		color: #1a1a1a; background-color: #c4a36a; font-size: 13px;
		padding: 6px 12px; border-radius: 14px;
	}
	.stats { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; padding-left: 4px; }
	.stat { color: #b0b4bc; font-size: 12px; margin-right: 14px; margin-bottom: 4px; }
	.tabs { flex-direction: row; margin: 4px 4px 12px 4px; }
	.tab { color: #8a8e96; font-size: 14px; margin-right: 18px; padding-bottom: 6px; }
	.tab-on {
		color: #e8c27a; font-weight: bold;
		border-bottom-width: 2px; border-bottom-color: #e8c27a; border-bottom-style: solid;
	}
	.grid { flex-direction: row; flex-wrap: wrap; }
	.grid-card { width: 33%; align-items: center; margin-bottom: 12px; }
	.post-row {
		flex-direction: row; background-color: #1c1f27; border-radius: 8px;
		padding: 10px; margin-bottom: 10px; margin-left: 4px; margin-right: 4px;
	}
	.post-meta { flex: 1; margin-left: 10px; justify-content: center; }
	.post-title { color: #f2f2f2; font-size: 14px; text-overflow: ellipsis; }
	.post-sub { margin-top: 6px; color: #8a8e96; font-size: 11px; }
	.empty { text-align: center; color: #6f737a; font-size: 13px; padding: 30px; }

	/* #ifdef APP-IOS */
	.follow-btn {
		font-size: 15px;
		padding: 10px 16px;
		border-radius: 16px;
		min-height: 24px;
	}
	.tab {
		padding-top: 10px;
		padding-bottom: 12px;
		min-height: 24px;
	}
	/* #endif */
</style>
