		padding: 16px;
	}
	.profile {
		flex-direction: row;
		align-items: center;
		padding: 16px 14px;
		background-color: #1A1D26;
		border-radius: 14px;
		margin-bottom: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #2A2E38;
	}
	.profile-hover {
		background-color: #22262F;
	}
	.avatar {
		width: 60px;
		height: 60px;
		border-radius: 30px;
		align-items: center;
		justify-content: center;
	}
