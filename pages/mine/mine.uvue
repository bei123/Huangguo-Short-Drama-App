		margin-top: 5px;
		color: #8A8E96;
		font-size: 13px;
		text-overflow: ellipsis;
	}
	.profile-action {
		color: #E8C27A;
		font-size: 13px;
		padding: 6px 12px;
		background-color: #2A261C;
		border-radius: 14px;
	}
	.stats {
		flex-direction: row;
		align-items: center;
		padding: 18px 8px;
		margin-bottom: 20px;
		background-color: #1A1D26;
		border-radius: 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #2A2E38;
	}
	.stat {
		flex: 1;
		align-items: center;
	}
	.stat-div {
		width: 1px;
		height: 28px;
		background-color: #2A2E38;
	}
	.stat-n {
		color: #E8C27A;
		font-size: 20px;
		font-weight: bold;
	}
	.stat-l {
		margin-top: 6px;
		color: #8A8E96;
		font-size: 12px;
	}
	.group-label {
		color: #8A8E96;
		font-size: 12px;
		margin-bottom: 8px;
		margin-left: 4px;
	}
	.menu-line-meta {
		flex: 1;
	}
	.menu-sub {
		margin-top: 4px;
		color: #8A8E96;
		font-size: 11px;
	}
	.sheet-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.55);
		justify-content: flex-end;
		z-index: 100;
	}
	.sheet {
		background-color: #1A1D26;
		border-top-left-radius: 18px;
		border-top-right-radius: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #2A2E38;
		overflow: hidden;
	}
	.sheet-handle-wrap {
		align-items: center;
		padding-top: 10px;
		padding-bottom: 4px;
	}
	.sheet-handle {
		width: 36px;
		height: 4px;
		border-radius: 2px;
		background-color: #3A3E48;
	}
	.sheet-top {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 8px 16px 12px 16px;
	}
	.sheet-titles {
		flex: 1;
	}
	.sheet-title {
		color: #F2F3F5;
		font-size: 17px;
		font-weight: bold;
	}
	.sheet-sub {
		margin-top: 4px;
		color: #8A8E96;
		font-size: 12px;
	}
	.sheet-action {
		color: #E8C27A;
		font-size: 13px;
		padding: 8px 12px;
		background-color: #2A261C;
		border-radius: 8px;
	}
	.sheet-scroll {
		flex: 1;
	}
	.line-item {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 14px 16px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #2A2E38;
	}
	.line-item-last {
		border-bottom-width: 0;
	}
	.line-item-on {
		background-color: #221E16;
	}
	.line-item-hover {
		background-color: #22262F;
	}
	.line-item-left {
		flex-direction: row;
		align-items: center;
		flex: 1;
		margin-right: 10px;
	}
	.line-host {
		color: #F2F3F5;
