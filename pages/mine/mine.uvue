	}
	.line-tag {
		margin-left: 8px;
		color: #1A1208;
		font-size: 10px;
		background-color: #E8C27A;
		padding: 2px 6px;
		border-radius: 4px;
	}
	.line-ms {
		font-size: 13px;
		font-weight: bold;
	}
	.line-ms-good {
		color: #7AC8A0;
	}
	.line-ms-mid {
		color: #E8C27A;
	}
	.line-ms-slow {
		color: #C89A7A;
	}
	.line-ms-bad {
		color: #E07070;
	}
	.line-empty {
		padding: 28px;
		align-items: center;
	}
	.line-empty-text {
		color: #6F737A;
		font-size: 13px;
	}
	.menu {
		background-color: #1A1D26;
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 18px;
	}
	.menu-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 16px 14px;
		border-bottom-width: 1px;
		border-bottom-color: #2A2E38;
		border-bottom-style: solid;
	}
	.menu-item-last {
		border-bottom-width: 0;
	}
	.menu-hover {
		background-color: #22262F;
	}
	.menu-text {
		color: #F2F3F5;
		font-size: 15px;
	}
	.menu-right {
		flex-direction: row;
		align-items: center;
	}
	.badge {
		color: #1A1208;
		font-size: 11px;
		background-color: #E8C27A;
		padding: 2px 7px;
		border-radius: 8px;
		margin-right: 8px;
	}
	.menu-arrow {
		color: #6F737A;
		font-size: 18px;
	}
	.logout {
		margin-top: 8px;
		height: 46px;
		border-radius: 12px;
