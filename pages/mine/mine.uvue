<template>
	<view class="root">
		<!-- #ifdef APP -->
		<scroll-view class="page" direction="vertical">
		<!-- #endif -->
			<view class="page-inner" :style="pagePadStyle">
				<view class="profile" hover-class="profile-hover" @click="onProfileTap">
					<view class="avatar" :style="{ backgroundColor: avatarColor }">
						<text class="avatar-text">{{avatarLetter}}</text>
					</view>
					<view class="profile-meta">
						<text class="name" :style="nameFontStyle">{{displayName}}</text>
						<text class="sign" max-lines="1">{{displaySign}}</text>
					</view>
					<text class="profile-action">{{loggedIn ? '编辑' : '登录'}}</text>
				</view>

				<view v-if="loggedIn" class="stats">
					<view class="stat" @click="goList('like')">
						<text class="stat-n">{{userLike}}</text>
						<text class="stat-l">点赞</text>
					</view>
					<view class="stat-div"></view>
					<view class="stat" @click="goList('collect')">
						<text class="stat-n">{{userCollect}}</text>
						<text class="stat-l">收藏</text>
					</view>
					<view class="stat-div"></view>
					<view class="stat" @click="goList('follow')">
						<text class="stat-n">{{userFollow}}</text>
						<text class="stat-l">关注</text>
					</view>
					<view class="stat-div"></view>
					<view class="stat" @click="goList('history')">
						<text class="stat-n">{{userHistory}}</text>
						<text class="stat-l">历史</text>
					</view>
				</view>

				<text class="group-label">我的内容</text>
				<view class="menu">
					<view class="menu-item" hover-class="menu-hover" @click="goList('history')">
						<text class="menu-text">观看历史</text>
						<text class="menu-arrow">›</text>
					</view>
					<view class="menu-item" hover-class="menu-hover" @click="goList('collect')">
						<text class="menu-text">我的收藏</text>
						<text class="menu-arrow">›</text>
					</view>
					<view class="menu-item" hover-class="menu-hover" @click="goList('like')">
						<text class="menu-text">我的点赞</text>
						<text class="menu-arrow">›</text>
					</view>
					<view class="menu-item menu-item-last" hover-class="menu-hover" @click="goList('follow')">
						<text class="menu-text">我的关注</text>
						<text class="menu-arrow">›</text>
					</view>
				</view>

				<text class="group-label">其他</text>
				<view class="menu">
					<view class="menu-item" hover-class="menu-hover" @click="goMessages">
						<text class="menu-text">消息中心</text>
						<view class="menu-right">
							<text v-if="unread > 0" class="badge">{{unread}}</text>
							<text class="menu-arrow">›</text>
						</view>
					</view>
					<view class="menu-item" hover-class="menu-hover" @click="goFeed">
						<text class="menu-text">推荐信息流</text>
						<text class="menu-arrow">›</text>
					</view>
					<view class="menu-item" hover-class="menu-hover" @click="openLineSheet">
						<view class="menu-line-meta">
							<text class="menu-text">切换线路</text>
							<text class="menu-sub">{{currentHost}}{{currentLatencyTip}}</text>
						</view>
						<text class="menu-arrow">›</text>
					</view>
					<view class="menu-item menu-item-last" hover-class="menu-hover" @click="goMore">
						<text class="menu-text">关于与站点</text>
						<text class="menu-arrow">›</text>
					</view>
				</view>

				<view v-if="loggedIn" class="logout" @click="doLogout">
					<text class="logout-text">退出登录</text>
				</view>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<!-- 半屏线路面板 -->
		<view v-if="lineSheetOpen" class="sheet-mask" @click="closeLineSheet">
			<view class="sheet" :style="sheetStyle" @click.stop="noop">
				<view class="sheet-handle-wrap">
					<view class="sheet-handle"></view>
				</view>
				<view class="sheet-top">
					<view class="sheet-titles">
						<text class="sheet-title">切换线路</text>
						<text class="sheet-sub">点选线路 · 延迟越低越快</text>
					</view>
					<text class="sheet-action" @click="refreshLines">{{lineMeasuring ? '测速中…' : '重新测速'}}</text>
				</view>
				<!-- #ifdef APP -->
				<scroll-view class="sheet-scroll" direction="vertical">
				<!-- #endif -->
					<view class="sheet-list" :style="sheetListPadStyle">
						<view
							v-for="(item, idx) in lines"
							:key="item.url"
							class="line-item"
							:class="lineItemClass(item, idx)"
							hover-class="line-item-hover"
							@click="pickLine(item)"
						>
							<view class="line-item-left">
								<text class="line-host">{{item.host}}</text>
								<text v-if="item.selected" class="line-tag">使用中</text>
							</view>
							<text class="line-ms" :class="latencyClass(item)">{{latencyText(item)}}</text>
						</view>
						<view v-if="lines.length == 0" class="line-empty">
							<text class="line-empty-text">{{lineMeasuring ? '正在测速…' : '暂无数据，请重新测速'}}</text>
						</view>
					</view>
				<!-- #ifdef APP -->
				</scroll-view>
				<!-- #endif -->
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { isLoggedIn, getUser, HgUser } from '../../common/auth/session.uts'
	import { fetchMe, logout } from '../../common/api/account.uts'
	import { fetchUnreadCount, prefetchMyHistory } from '../../common/api/interact.uts'
	import { installLiquidTabBar, syncLiquidTabIndex, uninstallLiquidTabBar } from '../../common/ui/liquid-tab.uts'
	import { TAB_BOTTOM_GAP } from '../../common/ui/glass-config.uts'
	import { refreshTypeScale, fontStyle } from '../../common/ui/type-scale.uts'
	import { getHgBaseUrl } from '../../common/http/config.uts'
	import {
		EndpointLatency,
		ensureEndpointReady,
		getLastLatencies,
		hostOf,
		measureAllEndpoints,
		switchToEndpoint
	} from '../../common/http/endpoint-probe.uts'

	const pagePadStyle = 'padding: 16px 16px ' + TAB_BOTTOM_GAP + 'px 16px'
	const nameFontStyle = ref(fontStyle(20))

	const loggedIn = ref(false)
	const displayName = ref('点击登录')
	const displaySign = ref('登录后同步云端数据')
	const avatarColor = ref('#8C8C8C')
	const avatarLetter = ref('?')
	const userLike = ref(0)
	const userCollect = ref(0)
	const userFollow = ref(0)
	const userHistory = ref(0)
	const unread = ref(0)

	const lines = ref<EndpointLatency[]>([] as EndpointLatency[])
	const lineMeasuring = ref(false)
	const lineSheetOpen = ref(false)
	const currentHost = ref(hostOf(getHgBaseUrl()))
	// 打开时隐藏原生 Tab，面板贴底；底距只留手势条
	const sheetH = Math.floor(uni.getWindowInfo().windowHeight * 0.55)
	let sheetSafeBot = 16
	try {
		const insets = uni.getWindowInfo().safeAreaInsets
		if (insets != null && insets.bottom > sheetSafeBot) {
			sheetSafeBot = insets.bottom
		}
	} catch (_) { }
	const sheetStyle = 'height:' + sheetH + 'px;margin-bottom:0px'
	const sheetListPadStyle = 'padding-bottom:' + (sheetSafeBot + 8) + 'px'

	const currentLatencyTip = computed((): string => {
		const cur = getHgBaseUrl()
		for (let i = 0; i < lines.value.length; i++) {
			const it = lines.value[i]
			if (it.url == cur && it.ok) {
				return ' · ' + it.ms + 'ms'
			}
		}
		return ''
	})

	function noop() { }

	function latencyText(item: EndpointLatency): string {
		if (!item.ok) {
			return '超时'
		}
		return item.ms + 'ms'
	}

	function latencyClass(item: EndpointLatency): string {
		if (!item.ok) {
			return 'line-ms-bad'
		}
		if (item.ms <= 300) {
			return 'line-ms-good'
		}
		if (item.ms <= 800) {
			return 'line-ms-mid'
		}
		return 'line-ms-slow'
	}

	function lineItemClass(item: EndpointLatency, idx: number): string {
		let c = ''
		if (item.selected) {
			c += 'line-item-on'
		}
		if (idx == lines.value.length - 1) {
			if (c.length > 0) {
				c += ' '
			}
			c += 'line-item-last'
		}
		return c
	}

	function syncLinesFromCache() {
		const cached = getLastLatencies()
		if (cached.length > 0) {
			lines.value = cached
		}
		currentHost.value = hostOf(getHgBaseUrl())
	}

	function openLineSheet() {
		lineSheetOpen.value = true
		try {
			uninstallLiquidTabBar()
		} catch (_) { }
		syncLinesFromCache()
		if (lines.value.length == 0) {
			refreshLines()
		}
	}

	function closeLineSheet() {
		const wasOpen = lineSheetOpen.value
		lineSheetOpen.value = false
		if (wasOpen) {
			try {
				syncLiquidTabIndex('/pages/mine/mine')
			} catch (_) { }
		}
	}

	async function refreshLines() {
		if (lineMeasuring.value) {
			return
		}
		lineMeasuring.value = true
		try {
			const list = await measureAllEndpoints()
			lines.value = list
			currentHost.value = hostOf(getHgBaseUrl())
		} catch (e) {
			uni.showToast({ title: '测速失败', icon: 'none' })
			console.log('[mine] line measure ' + e)
		} finally {
			lineMeasuring.value = false
		}
	}

	function pickLine(item: EndpointLatency) {
		if (!item.ok) {
			uni.showToast({ title: '该线路不可用', icon: 'none' })
			return
		}
		if (item.selected) {
			uni.showToast({ title: '已在使用', icon: 'none' })
			return
		}
		switchToEndpoint(item.url)
		currentHost.value = item.host
		const next: EndpointLatency[] = [] as EndpointLatency[]
		for (let i = 0; i < lines.value.length; i++) {
			const it = lines.value[i]
			next.push({
				url: it.url,
				host: it.host,
				ms: it.ms,
				ok: it.ok,
				selected: it.url == item.url
			} as EndpointLatency)
		}
		lines.value = next
		uni.showToast({ title: '已切换 ' + item.host, icon: 'none' })
		closeLineSheet()
	}

	function applyUser(u: HgUser | null) {
		loggedIn.value = isLoggedIn()
		if (u == null || !loggedIn.value) {
			displayName.value = '点击登录'
			displaySign.value = '登录后同步云端数据'
			avatarColor.value = '#8C8C8C'
			avatarLetter.value = '?'
			userLike.value = 0
			userCollect.value = 0
			userFollow.value = 0
			userHistory.value = 0
			return
		}
		displayName.value = u.nickname.length > 0 ? u.nickname : u.username
		displaySign.value = u.sign.length > 0 ? u.sign : '欢迎回来'
		avatarColor.value = u.avatarColor.length > 0 ? u.avatarColor : '#8C8C8C'
		avatarLetter.value = displayName.value.substring(0, 1)
		userLike.value = u.likeCount
		userCollect.value = u.collectCount
		userFollow.value = u.followingCount
		userHistory.value = u.historyCount
	}

	async function refresh() {
		applyUser(getUser())
		if (!isLoggedIn()) {
			return
		}
		try {
			await ensureEndpointReady()
		} catch (_) { }
		try {
			const me = await fetchMe()
			applyUser(me)
		} catch (_) {
			applyUser(getUser())
		}
		try {
			unread.value = await fetchUnreadCount()
		} catch (_) {
			unread.value = 0
		}
		// 稍后再预热，避免和刚进「我的」的 me/未读抢 user 队列；点进历史也能插队
		setTimeout(() => {
			prefetchMyHistory()
		}, 800)
	}

	function requireLogin(): boolean {
		if (isLoggedIn()) {
			return true
		}
		uni.navigateTo({ url: '/pages/login/login' })
		return false
	}

	function onProfileTap() {
		if (!isLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		uni.navigateTo({ url: '/pages/profile-edit/profile-edit' })
	}

	function goList(type: string) {
		if (!requireLogin()) {
			return
		}
		uni.navigateTo({ url: '/pages/my-list/my-list?type=' + type })
	}

	function goMessages() {
		if (!requireLogin()) {
			return
		}
		uni.navigateTo({ url: '/pages/messages/messages' })
	}

	function goFeed() {
		uni.navigateTo({ url: '/pages/feed/feed' })
	}

	function goMore() {
		uni.navigateTo({ url: '/pages/more/more' })
	}

	async function doLogout() {
		// #ifdef APP-IOS
		// HIG 7.2：破坏性操作需确认，避免误触
		uni.showModal({
			title: '退出登录',
			content: '退出后本地同步的收藏与历史将需重新登录查看。',
			confirmText: '退出',
			confirmColor: '#E07070',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					logout().then(() => {
						applyUser(null)
						uni.showToast({ title: '已退出', icon: 'none' })
					})
				}
			}
		})
		// #endif
		// #ifndef APP-IOS
		await logout()
		applyUser(null)
		uni.showToast({ title: '已退出', icon: 'none' })
		// #endif
	}

	onShow(() => {
		refreshTypeScale()
		nameFontStyle.value = fontStyle(20)
		refresh()
		syncLinesFromCache()
		try {
			installLiquidTabBar()
			syncLiquidTabIndex('/pages/mine/mine')
		} catch (_) { }
	})
</script>

<style>
	.root {
		flex: 1;
		background-color: #12141a;
	}
	.page {
		flex: 1;
		background-color: #12141a;
	}
