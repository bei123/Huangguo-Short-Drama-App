		justify-content: center;
	}
	.logout-text {
		color: #E07070;
		font-size: 15px;
	}

	/* #ifdef APP-IOS */
	.profile-action {
		font-size: 15px;
		padding: 10px 16px;
		min-height: 24px;
		border-radius: 16px;
	}
	.stat {
		min-height: 44px;
		justify-content: center;
	}
	.menu-item {
		min-height: 44px;
		padding: 14px 16px;
	}
	.logout {
		height: 50px;
		border-radius: 12px;
	}
	/* #endif */
</style>
