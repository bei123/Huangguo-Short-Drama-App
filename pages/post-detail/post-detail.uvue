<template>
	<!-- #ifdef APP -->
	<scroll-view class="page" direction="vertical">
	<!-- #endif -->
		<view class="page-inner">
			<view v-if="loading" class="state-box">
				<text class="state-text">加载中…</text>
			</view>
			<template v-else-if="detail != null">
				<text class="title">{{detail!.title}}</text>
				<text class="meta">{{detail!.authorName}} · 热度 {{formatHot(detail!.hot)}}</text>
				<view class="actions">
					<text class="action" @click="toggleLike">{{liked ? '已赞' : '点赞'}} {{formatHot(detail!.like)}}</text>
					<text class="action" @click="toggleCollect">{{collected ? '已藏' : '收藏'}} {{formatHot(detail!.collect)}}</text>
					<text v-if="detail!.authorId > 0" class="action" @click="goAuthor">作者主页</text>
				</view>
				<hg-cover v-if="detail!.cover.length > 0" :src="detail!.cover" :width="340" :height="180" :radius="8"></hg-cover>
				<text class="content">{{plainContent}}</text>
				<view class="tags">
					<text v-for="(t, i) in detail!.tags" :key="i" class="tag">{{t}}</text>
				</view>
			</template>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { fetchPostDetail, likePost, collectPost, visitPost } from '../../common/api/posts.uts'
	import { PostDetail } from '../../common/models/extra.uts'
	import { isLoggedIn } from '../../common/auth/session.uts'

	const postId = ref('')
	const loading = ref(true)
	const detail = ref<PostDetail | null>(null)
	const liked = ref(false)
	const collected = ref(false)
	const plainContent = ref('')

	function formatHot(n: number): string {
		if (n >= 10000) {
			return (n / 10000).toFixed(1) + '万'
		}
		return '' + n
	}

	function stripHtml(html: string): string {
		let s = html
		s = s.replace('<br>', '\n')
		s = s.replace('<br/>', '\n')
		s = s.replace('<br />', '\n')
		s = s.replace('</p>', '\n')
		s = s.replace('&nbsp;', ' ')
		s = s.replace('&lt;', '<')
		s = s.replace('&gt;', '>')
		s = s.replace('&amp;', '&')
		let guard = 0
		while (guard < 500) {
			const start = s.indexOf('<')
			if (start < 0) {
				break
			}
			const end = s.indexOf('>', start)
			if (end < 0) {
				break
			}
			s = s.substring(0, start) + ' ' + s.substring(end + 1)
			guard++
		}
		return s.trim()
	}

	function requireLogin(): boolean {
		if (isLoggedIn()) {
			return true
		}
		uni.navigateTo({ url: '/pages/login/login' })
		return false
	}

	async function load() {
		loading.value = true
		try {
			const d = await fetchPostDetail(postId.value)
			detail.value = d
			liked.value = d.liked
			collected.value = d.collected
			plainContent.value = stripHtml(d.content)
			uni.setNavigationBarTitle({ title: d.title.length > 12 ? d.title.substring(0, 12) + '…' : d.title })
			// 文档 16.4：登录态下 visit 才会写入吃瓜历史 HTML
			if (isLoggedIn() && postId.value.length > 0) {
				visitPost(postId.value)
			}
		} catch (e) {
			console.log('[post] ' + e)
		} finally {
			loading.value = false
		}
	}

	async function toggleLike() {
		if (!requireLogin() || detail.value == null) {
			return
		}
		try {
			liked.value = await likePost(postId.value, !liked.value)
		} catch (e) {
			uni.showToast({ title: '' + e, icon: 'none' })
		}
	}

	async function toggleCollect() {
		if (!requireLogin() || detail.value == null) {
			return
		}
		try {
			collected.value = await collectPost(postId.value, !collected.value)
		} catch (e) {
			uni.showToast({ title: '' + e, icon: 'none' })
		}
	}

	function goAuthor() {
		if (detail.value == null || detail.value!.authorId <= 0) {
			return
		}
		uni.navigateTo({ url: '/pages/author/author?id=' + detail.value!.authorId })
	}

	onLoad((options) => {
		postId.value = options['id'] ?? ''
		load()
	})
</script>

<style>
	.page { flex: 1; background-color: #12141a; }
	.page-inner { padding: 14px; }
	.state-box { padding-top: 80px; align-items: center; }
	.state-text { color: #9aa0aa; font-size: 14px; }
	.title { color: #f5f5f5; font-size: 20px; font-weight: bold; }
	.meta { margin-top: 8px; color: #8a8e96; font-size: 12px; }
	.actions { flex-direction: row; margin-top: 12px; margin-bottom: 12px; }
	.action {
		color: #e8c27a; font-size: 13px; margin-right: 16px;
		background-color: #1c1f27; padding: 6px 10px; border-radius: 4px;
	}
	.content { margin-top: 14px; color: #c8ccd3; font-size: 14px; }
	.tags { flex-direction: row; flex-wrap: wrap; margin-top: 16px; }
	.tag {
		background-color: #1c1f27; color: #c8ccd3; font-size: 11px;
		padding: 4px 8px; border-radius: 4px; margin-right: 6px; margin-bottom: 6px;
	}
</style>
